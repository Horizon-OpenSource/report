@startuml
title EcoTrack Platform - IAM Backend Domain Layer - PasswordResetToken Aggregate
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
hide circle

package "Domain / PasswordResetToken Aggregate" {

  package "Aggregates" {
    class PasswordResetToken <<Aggregate Root>> {
      +id: Long
      +userId: Long
      +token: String
      +expiresAt: LocalDateTime
      +used: boolean
      +isExpired(): boolean
      +markAsUsed(): void
    }
  }

  package "Commands" {
    class RequestPasswordResetCommand {
      +email: String
    }
    class ResetPasswordCommand {
      +token: String
      +newPassword: String
    }
  }

  package "Events" {
    class PasswordResetRequestedEvent {
      +userId: Long
      +token: String
      +occurredOn: LocalDateTime
    }
    class PasswordResetCompletedEvent {
      +userId: Long
      +occurredOn: LocalDateTime
    }
  }

  package "Repositories" {
    interface PasswordResetTokenRepository {
      +findByToken(token: String): PasswordResetToken
      +save(token: PasswordResetToken): PasswordResetToken
    }
  }

  PasswordResetTokenRepository ..> PasswordResetToken
}

package "Interfaces REST" as Backend_iam_Interfaces_REST <<layer>> {
}
package "Application" as Backend_iam_Application <<layer>> {
}
package "Infrastructure" as Backend_iam_Infrastructure <<layer>> {
}

Backend_iam_Application ..> RequestPasswordResetCommand : handles
Backend_iam_Application ..> ResetPasswordCommand : handles
Backend_iam_Infrastructure ..> PasswordResetTokenRepository : implements
Backend_iam_Interfaces_REST ..> PasswordResetToken : resources from

@enduml
