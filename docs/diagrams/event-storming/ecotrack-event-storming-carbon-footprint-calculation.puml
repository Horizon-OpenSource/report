@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam nodesep 25
skinparam ranksep 70
skinparam ArrowColor #4A4A4A
skinparam RectangleBorderColor #555555
skinparam RectangleFontStyle bold
skinparam roundCorner 12
skinparam rectangle<<ext>> {
  BackgroundColor #828282
  FontColor white
}
skinparam rectangle<<rm>> {
  BackgroundColor #27AE60
  FontColor white
}
skinparam rectangle<<pol>> {
  BackgroundColor #EB5757
  FontColor white
}
skinparam rectangle<<evt>> {
  BackgroundColor #F2994A
  FontColor white
}
skinparam rectangle<<agg>> {
  BackgroundColor #F2C94C
  FontColor #17324D
}
skinparam rectangle<<cmd>> {
  BackgroundColor #2D9CDB
  FontColor white
}
skinparam rectangle<<actor>> {
  BackgroundColor #9B51E0
  FontColor white
}
skinparam titleFontSize 20
hide stereotype
title EcoTrack - Carbon Footprint Calculation Event Storming (Core)

rectangle "Environmental\nAnalyst" as a <<actor>>
rectangle "Emissions Management\n(external context)" as x <<ext>>
rectangle "CalculateFootprint" as c <<cmd>>
rectangle "FootprintCalculation" as g <<agg>>
rectangle "CarbonFootprintCalculated" as e <<evt>>
rectangle "Results by Scope\nGetResultsByScopeQuery" as r1 <<rm>>
rectangle "Results by Period\nGetResultsByPeriodQuery" as r2 <<rm>>
rectangle "Calculation History\nGetHistoryQuery" as r3 <<rm>>
rectangle "EmissionFactor\n(factor catalog)" as f <<agg>>
rectangle "Emission Factors Catalog\nGetEmissionFactorsQuery" as r4 <<rm>>

a --> c
x --> c : activity data
f ..> c : compatible factor
c --> g
g --> e
e --> r1
e --> r2
e --> r3
f --> r4
a -[hidden]down-> x
g -[hidden]down-> f
r1 -[hidden]down-> r2
r2 -[hidden]down-> r3
r3 -[hidden]down-> r4
a -[hidden]right-> c
c -[hidden]right-> g
g -[hidden]right-> e
e -[hidden]right-> r1
legend right
  |<#9B51E0><color:white> Actor </color>|
  |<#2D9CDB><color:white> Command </color>|
  |<#F2C94C><color:#17324D> Aggregate </color>|
  |<#F2994A><color:white> Domain Event </color>|
  |<#EB5757><color:white> Policy </color>|
  |<#27AE60><color:white> Read Model / Query </color>|
  |<#828282><color:white> External </color>|
endlegend
@enduml