@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam nodesep 25
skinparam ranksep 70
skinparam ArrowColor #4A4A4A
skinparam RectangleBorderColor #555555
skinparam RectangleFontStyle bold
skinparam roundCorner 12
skinparam rectangle<<ext>> {
  BackgroundColor #828282
  FontColor white
}
skinparam rectangle<<rm>> {
  BackgroundColor #27AE60
  FontColor white
}
skinparam rectangle<<pol>> {
  BackgroundColor #EB5757
  FontColor white
}
skinparam rectangle<<evt>> {
  BackgroundColor #F2994A
  FontColor white
}
skinparam rectangle<<agg>> {
  BackgroundColor #F2C94C
  FontColor #17324D
}
skinparam rectangle<<cmd>> {
  BackgroundColor #2D9CDB
  FontColor white
}
skinparam rectangle<<actor>> {
  BackgroundColor #9B51E0
  FontColor white
}
skinparam titleFontSize 20
hide stereotype
title EcoTrack - Organization Management Event Storming (Supporting)

rectangle "Business\nRepresentative" as a1 <<actor>>
rectangle "Administrator" as a2 <<actor>>
rectangle "RegisterOrganization" as c1 <<cmd>>
rectangle "UpdateOrganization" as c2 <<cmd>>
rectangle "RegisterFacility" as c3 <<cmd>>
rectangle "RegisterBusinessUnit" as c4 <<cmd>>
rectangle "Organization" as g1 <<agg>>
rectangle "Organization" as g2 <<agg>>
rectangle "Facility" as g3 <<agg>>
rectangle "BusinessUnit" as g4 <<agg>>
rectangle "OrganizationRegistered" as e1 <<evt>>
rectangle "OrganizationUpdated" as e2 <<evt>>
rectangle "FacilityRegistered" as e3 <<evt>>
rectangle "BusinessUnitRegistered" as e4 <<evt>>
rectangle "Organization Profile\nGetOrganizationProfileQuery" as r <<rm>>

a1 --> c1
a2 --> c2
a2 --> c3
a2 --> c4
c1 --> g1
c2 --> g2
c3 --> g3
c4 --> g4
g1 --> e1
g2 --> e2
g3 --> e3
g4 --> e4
e1 --> r
e2 --> r
e3 --> r
e4 --> r
a1 -[hidden]down-> a2
c1 -[hidden]down-> c2
c2 -[hidden]down-> c3
c3 -[hidden]down-> c4
g1 -[hidden]down-> g2
g2 -[hidden]down-> g3
g3 -[hidden]down-> g4
e1 -[hidden]down-> e2
e2 -[hidden]down-> e3
e3 -[hidden]down-> e4
a1 -[hidden]right-> c1
c1 -[hidden]right-> g1
g1 -[hidden]right-> e1
e1 -[hidden]right-> r
legend right
  |<#9B51E0><color:white> Actor </color>|
  |<#2D9CDB><color:white> Command </color>|
  |<#F2C94C><color:#17324D> Aggregate </color>|
  |<#F2994A><color:white> Domain Event </color>|
  |<#EB5757><color:white> Policy </color>|
  |<#27AE60><color:white> Read Model / Query </color>|
  |<#828282><color:white> External </color>|
endlegend
@enduml