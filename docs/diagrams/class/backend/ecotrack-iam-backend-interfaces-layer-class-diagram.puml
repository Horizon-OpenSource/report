@startuml
title EcoTrack Platform - IAM Backend Interfaces REST Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
hide circle

package "Interfaces REST" {
  class AuthController {
    +createUserAccount(resource: CreateUserAccountResource): UserResource
    +signIn(resource: SignInResource): TokenResource
    +requestPasswordReset(resource: RequestPasswordResetResource): void
    +resetPassword(resource: ResetPasswordResource): void
    +inviteUser(resource: InviteUserResource): InvitationResource
    +acceptInvitation(resource: AcceptInvitationResource): UserResource
    +assignRole(userId: Long, resource: AssignRoleResource): UserResource
  }

  class CreateUserAccountResource {
    +fullName: String
    +email: String
    +password: String
  }

  class SignInResource {
    +email: String
    +password: String
  }

  class AssignRoleResource {
    +role: String
  }

  class RequestPasswordResetResource {
    +email: String
  }

  class ResetPasswordResource {
    +token: String
    +newPassword: String
  }

  class InviteUserResource {
    +email: String
    +role: String
  }

  class AcceptInvitationResource {
    +token: String
    +fullName: String
    +password: String
  }

  class UserResource {
    +id: Long
    +organizationId: Long
    +fullName: String
    +email: String
    +role: String
    +status: String
  }

  class InvitationResource {
    +id: Long
    +email: String
    +role: String
    +status: String
  }

  class TokenResource {
    +accessToken: String
    +expiresAt: LocalDateTime
  }

  class UserResourceAssembler {
    +{static} toResourceFrom(user: User): UserResource
  }

  class InvitationResourceAssembler {
    +{static} toResourceFrom(invitation: Invitation): InvitationResource
  }

  AuthController ..> CreateUserAccountResource : receives
  AuthController ..> SignInResource : receives
  AuthController ..> AssignRoleResource : receives
  AuthController ..> RequestPasswordResetResource : receives
  AuthController ..> ResetPasswordResource : receives
  AuthController ..> InviteUserResource : receives
  AuthController ..> AcceptInvitationResource : receives
  AuthController ..> UserResource : returns
  AuthController ..> InvitationResource : returns
  AuthController ..> TokenResource : returns
  UserResourceAssembler ..> UserResource : builds
  InvitationResourceAssembler ..> InvitationResource : builds
}

package "Application" as Backend_iam_Application <<layer>> {
}
package "Domain" as Backend_iam_Domain <<layer>> {
}
package "Infrastructure" as Backend_iam_Infrastructure <<layer>> {
}

AuthController ..> Backend_iam_Application : delegates use cases
UserResourceAssembler ..> Backend_iam_Domain : reads aggregates
InvitationResourceAssembler ..> Backend_iam_Domain : reads aggregates

@enduml
