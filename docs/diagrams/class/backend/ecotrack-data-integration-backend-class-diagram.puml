@startuml
title EcoTrack Platform - Data Integration Backend Bounded Context Layers
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle

package "Data Integration Backend Bounded Context" {
  class "Interfaces REST" as Backend_dataint_Interfaces_REST <<layer>>
  class "Application" as Backend_dataint_Application <<layer>>
  class "Domain" as Backend_dataint_Domain <<layer>>
  class "Infrastructure" as Backend_dataint_Infrastructure <<layer>>
}

Backend_dataint_Interfaces_REST ..> Backend_dataint_Application : commands / queries
Backend_dataint_Application ..> Backend_dataint_Domain : model and policies
Backend_dataint_Application ..> Backend_dataint_Infrastructure : repository ports / adapters
Backend_dataint_Infrastructure ..> Backend_dataint_Domain : persistence mapping
Backend_dataint_Interfaces_REST ..> Backend_dataint_Domain : resources from aggregates

@enduml
