@startuml
title EcoTrack Platform - Carbon Footprint Calculation Backend Domain Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
skinparam enum {
  BackgroundColor #FDF3E3
  BorderColor #C9832B
  FontColor #5A3E12
}
hide circle

package "Domain" {
  package "Aggregates" {
    class EmissionFactor <<Aggregate Root>> {
      -id: EmissionFactorId
      -name: String
      -scope: ScopeType
      -factorValue: EmissionFactorValue
      -source: FactorSource
      +isCompatibleWith(scope: ScopeType, unit: String): boolean
      +convert(quantity: ActivityQuantity): CarbonEmissions
    }
    class FootprintCalculation <<Aggregate Root>> {
      -id: FootprintCalculationId
      -organizationId: OrganizationId
      -period: ReportingPeriod
      -items: List<CalculationItem>
      -calculatedAt: LocalDateTime
      +addItem(item: CalculationItem): void
      +totalEmissions(): CarbonEmissions
      +totalByScope(scope: ScopeType): CarbonEmissions
    }
    class CalculationItem <<Entity>> {
      -id: CalculationItemId
      -activityDataId: ActivityDataId
      -emissionFactorId: EmissionFactorId
      -scope: ScopeType
      -emissions: CarbonEmissions
    }
  }

  package "Value Objects" {
    class ActivityDataId <<Value Object>> {
      -value: UUID
    }
    class EmissionFactorId <<Value Object>> {
      -value: UUID
    }
    class FootprintCalculationId <<Value Object>> {
      -value: UUID
    }
    class CalculationItemId <<Value Object>> {
      -value: UUID
    }
    class ActivityQuantity <<Value Object>> {
      -amount: BigDecimal
      -unit: String
      +isPositive(): boolean
    }
    class FactorSource <<Value Object>> {
      -name: String
      -year: int
    }
    class ActivityFactorSelection <<Value Object>> {
      -factorId: EmissionFactorId
      -quantity: ActivityQuantity
      -scope: ScopeType
    }
    enum ScopeType <<Value Object>> {
      SCOPE_1
      SCOPE_2
      SCOPE_3
    }
    class OrganizationId <<Value Object>> {
      -value: UUID
    }
    class ReportingPeriod <<Value Object>> {
      -year: int
      -month: int
      +toString(): String
      +contains(date: LocalDate): boolean
    }
    class EmissionFactorValue <<Value Object>> {
      -factor: BigDecimal
      -unit: String
      +multiply(quantity: ActivityQuantity): CarbonEmissions
    }
    class CarbonEmissions <<Value Object>> {
      -amount: BigDecimal
      -unit: String = "kgCO2e"
      +add(other: CarbonEmissions): CarbonEmissions
      +toTonnes(): BigDecimal
    }
  }

  package "Commands" {
    class CalculateFootprintCommand {
      +organizationId: OrganizationId
      +period: ReportingPeriod
      +items: List<ActivityFactorSelection>
    }
  }

  package "Queries" {
    class GetEmissionFactorsQuery {
    }
    class GetResultsByScopeQuery {
      +scope: ScopeType
    }
    class GetResultsByPeriodQuery {
      +period: ReportingPeriod
    }
    class GetHistoryQuery {
      +organizationId: OrganizationId
    }
  }

  package "Events" {
    class CarbonFootprintCalculatedEvent {
      +footprintCalculationId: FootprintCalculationId
      +occurredOn: LocalDateTime
    }
  }

  package "Repositories" {
    interface EmissionFactorRepository {
      +findAll(): List<EmissionFactor>
      +findById(id: EmissionFactorId): Optional<EmissionFactor>
    }
    interface FootprintCalculationRepository {
      +findByScope(scope: ScopeType): List<FootprintCalculation>
      +findByPeriod(period: ReportingPeriod): List<FootprintCalculation>
      +save(calculation: FootprintCalculation): FootprintCalculation
    }
  }

  EmissionFactor "1" *-- "1" FactorSource : sourced from
  FootprintCalculation "1" *-- "1..*" CalculationItem : contains >
  FootprintCalculation "1" *-- "1" ReportingPeriod : covers >
  FootprintCalculation "1" *-- "1" OrganizationId : belongs to >
  CalculationItem "1" *-- "1" CarbonEmissions : results in >
  CalculationItem "1" *-- "1" ScopeType : classified by >
  CalculationItem "0..*" ..> "1" EmissionFactor : calculated with >
  EmissionFactor "1" *-- "1" EmissionFactorValue : defined by >
  EmissionFactor "1" *-- "1" ScopeType : applies to >
  EmissionFactorValue ..> CarbonEmissions : produces
  EmissionFactorRepository ..> EmissionFactor : persists
  FootprintCalculationRepository ..> FootprintCalculation : persists
  EmissionFactor "1" *-- "1" EmissionFactorId : identified by
  FootprintCalculation "1" *-- "1" FootprintCalculationId : identified by
  CalculationItem "1" *-- "1" CalculationItemId : identified by
}

package "Interfaces REST" as Backend_footprint_Interfaces_REST <<layer>> {
}
package "Application" as Backend_footprint_Application <<layer>> {
}
package "Infrastructure" as Backend_footprint_Infrastructure <<layer>> {
}

Backend_footprint_Interfaces_REST ..> FootprintCalculation : resources from
Backend_footprint_Application ..> CalculateFootprintCommand : handles
Backend_footprint_Infrastructure ..> EmissionFactorRepository : implements
Backend_footprint_Infrastructure ..> FootprintCalculationRepository : implements

@enduml
