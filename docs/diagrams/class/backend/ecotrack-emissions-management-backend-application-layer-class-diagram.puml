@startuml
title EcoTrack Platform - Emissions Management Backend Application Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
hide circle

package "Application" {
  class EmissionCommandService {
    +handle(command: RegisterEmissionSourceCommand): EmissionSource
    +handle(command: EditEmissionSourceCommand): EmissionSource
    +handle(command: DeleteEmissionSourceCommand): void
    +handle(command: RecordActivityDataCommand): ActivityData
  }

  class EmissionQueryService {
    +handle(query: SearchEmissionSourcesQuery): List<EmissionSource>
    +handle(query: FilterByScopeQuery): List<EmissionSource>
  }

  interface OrganizationApiPort {
    +validateFacilityScope(facilityId: Long): boolean
  }

  EmissionCommandService ..> OrganizationApiPort : uses
}

package "Interfaces REST" as Backend_emissions_Interfaces_REST <<layer>> {
}
package "Domain" as Backend_emissions_Domain <<layer>> {
}
package "Infrastructure" as Backend_emissions_Infrastructure <<layer>> {
}

Backend_emissions_Interfaces_REST ..> EmissionCommandService : delegates
Backend_emissions_Interfaces_REST ..> EmissionQueryService : delegates
EmissionCommandService ..> Backend_emissions_Domain : applies rules
EmissionQueryService ..> Backend_emissions_Domain : reads aggregates
OrganizationApiPort ..> Backend_emissions_Infrastructure : implemented by

@enduml
