@startuml
title EcoTrack Platform - Goals and Reduction Plans Backend Domain Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
skinparam enum {
  BackgroundColor #FDF3E3
  BorderColor #C9832B
  FontColor #5A3E12
}
hide circle

package "Domain" {
  package "Aggregates" {
    class ReductionGoal <<Aggregate Root>> {
      -id: ReductionGoalId
      -organizationId: OrganizationId
      -name: String
      -target: GoalTarget
      -status: GoalStatus
      +edit(name: String, target: GoalTarget): void
      +updateStatus(status: GoalStatus): void
      +createReductionPlan(name: String, description: String): ReductionPlan
      +progress(current: CarbonEmissions): double
    }
  }

  package "Entities" {
    class ReductionPlan <<Entity>> {
      -id: ReductionPlanId
      -name: String
      -description: String
      +registerInitiative(name: String, description: String): EnvironmentalInitiative
    }
    class EnvironmentalInitiative <<Entity>> {
      -id: EnvironmentalInitiativeId
      -name: String
      -description: String
    }
  }

  package "Value Objects" {
    class EnvironmentalInitiativeId <<Value Object>> {
      -value: UUID
    }
    class ReductionGoalId <<Value Object>> {
      -value: UUID
    }
    class ReductionPlanId <<Value Object>> {
      -value: UUID
    }
    enum GoalStatus <<Value Object>> {
      ACTIVE
      ACHIEVED
      AT_RISK
    }
    class OrganizationId <<Value Object>> {
      -value: UUID
    }
    class GoalTarget <<Value Object>> {
      -reductionValue: BigDecimal
      -unit: String = "kgCO2e"
      -targetDate: LocalDate
      +isReachedBy(current: CarbonEmissions): boolean
    }
    class CarbonEmissions <<Value Object>> {
      -amount: BigDecimal
      -unit: String
    }
  }

  package "Commands" {
    class RegisterReductionGoalCommand {
      +organizationId: OrganizationId
      +name: String
      +target: GoalTarget
    }
    class EditReductionGoalCommand {
      +goalId: ReductionGoalId
      +name: String
      +target: GoalTarget
    }
    class UpdateGoalStatusCommand {
      +goalId: ReductionGoalId
      +status: GoalStatus
    }
    class DeleteReductionGoalCommand {
      +goalId: ReductionGoalId
    }
    class CreateReductionPlanCommand {
      +reductionGoalId: ReductionGoalId
      +name: String
      +description: String
    }
    class RegisterInitiativeCommand {
      +reductionPlanId: ReductionPlanId
      +name: String
      +description: String
    }
  }

  package "Queries" {
    class GetReductionGoalsQuery {
      +organizationId: OrganizationId
    }
    class GetProgressQuery {
      +organizationId: OrganizationId
    }
  }

  package "Events" {
    class ReductionGoalRegisteredEvent {
      +goalId: ReductionGoalId
      +occurredOn: LocalDateTime
    }
    class GoalStatusUpdatedEvent {
      +goalId: ReductionGoalId
      +status: GoalStatus
      +occurredOn: LocalDateTime
    }
    class ReductionPlanCreatedEvent {
      +planId: ReductionPlanId
      +occurredOn: LocalDateTime
    }
    class EnvironmentalInitiativeRegisteredEvent {
      +initiativeId: EnvironmentalInitiativeId
      +occurredOn: LocalDateTime
    }
  }

  package "Repositories" {
    interface ReductionGoalRepository {
      +findById(id: ReductionGoalId): Optional<ReductionGoal>
      +findByOrganizationId(organizationId: OrganizationId): List<ReductionGoal>
      +save(goal: ReductionGoal): ReductionGoal
    }
  }

  ReductionGoal "1" *-- "0..*" ReductionPlan : has >
  ReductionPlan "1" *-- "0..*" EnvironmentalInitiative : has >
  ReductionGoal "1" *-- "1" GoalTarget : aims for >
  ReductionGoal "1" *-- "1" GoalStatus : currently in >
  ReductionGoal "1" *-- "1" OrganizationId : belongs to >
  GoalTarget ..> CarbonEmissions : compared with
  ReductionGoalRepository ..> ReductionGoal : persists
  ReductionGoal "1" *-- "1" ReductionGoalId : identified by
  ReductionPlan "1" *-- "1" ReductionPlanId : identified by
  EnvironmentalInitiative "1" *-- "1" EnvironmentalInitiativeId : identified by
}

package "Interfaces REST" as Backend_goals_Interfaces_REST <<layer>> {
}
package "Application" as Backend_goals_Application <<layer>> {
}
package "Infrastructure" as Backend_goals_Infrastructure <<layer>> {
}

Backend_goals_Interfaces_REST ..> ReductionGoal : resources from
Backend_goals_Application ..> RegisterReductionGoalCommand : handles
Backend_goals_Application ..> EditReductionGoalCommand : handles
Backend_goals_Application ..> UpdateGoalStatusCommand : handles
Backend_goals_Application ..> DeleteReductionGoalCommand : handles
Backend_goals_Application ..> CreateReductionPlanCommand : handles
Backend_goals_Application ..> RegisterInitiativeCommand : handles
Backend_goals_Infrastructure ..> ReductionGoalRepository : implements

@enduml
