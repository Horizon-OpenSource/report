@startuml
title EcoTrack Platform - Organization Management Backend Domain Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
hide circle

package "Domain" {
  package "Aggregates" {
    class Organization <<Aggregate Root>> {
      -id: OrganizationId
      -name: String
      -sector: String
      -createdAt: LocalDateTime
      +registerFacility(name: String, address: Address): Facility
      +registerBusinessUnit(name: String): BusinessUnit
      +update(name: String, sector: String): void
    }
  }

  package "Entities" {
    class Facility {
      -id: FacilityId
      -organizationId: OrganizationId
      -name: String
      -address: Address
    }
    class BusinessUnit {
      -id: BusinessUnitId
      -organizationId: OrganizationId
      -name: String
    }
  }

  package "Value Objects" {
    class BusinessUnitId <<Value Object>> {
      -value: UUID
    }
    class FacilityId <<Value Object>> {
      -value: UUID
    }
    class OrganizationId <<Value Object>> {
      -value: UUID
    }
    class Address <<Value Object>> {
      -value: String
      +isBlank(): boolean
    }
  }

  package "Commands" {
    class RegisterOrganizationCommand {
      +name: String
      +sector: String
    }
    class UpdateOrganizationCommand {
      +organizationId: OrganizationId
      +name: String
      +sector: String
    }
    class RegisterFacilityCommand {
      +organizationId: OrganizationId
      +name: String
      +address: Address
    }
    class RegisterBusinessUnitCommand {
      +organizationId: OrganizationId
      +name: String
    }
  }

  package "Queries" {
    class GetOrganizationProfileQuery {
      +organizationId: OrganizationId
    }
  }

  package "Events" {
    class OrganizationRegisteredEvent {
      +organizationId: OrganizationId
      +occurredOn: LocalDateTime
    }
    class FacilityRegisteredEvent {
      +organizationId: OrganizationId
      +facilityId: FacilityId
      +occurredOn: LocalDateTime
    }
    class BusinessUnitRegisteredEvent {
      +organizationId: OrganizationId
      +businessUnitId: BusinessUnitId
      +occurredOn: LocalDateTime
    }
  }

  package "Repositories" {
    interface OrganizationRepository {
      +findById(id: OrganizationId): Organization
      +save(organization: Organization): Organization
    }
  }

  Organization "1" *-- "1" OrganizationId : identified by
  Organization "1" *-- "0..*" Facility : has
  Facility "1" *-- "1" Address : located at
  Organization "1" *-- "0..*" BusinessUnit : has
  OrganizationRepository ..> Organization : persists
  Facility "1" *-- "1" FacilityId : identified by
  BusinessUnit "1" *-- "1" BusinessUnitId : identified by
}

package "Interfaces REST" as Backend_orgmgmt_Interfaces_REST <<layer>> {
}
package "Application" as Backend_orgmgmt_Application <<layer>> {
}
package "Infrastructure" as Backend_orgmgmt_Infrastructure <<layer>> {
}

Backend_orgmgmt_Interfaces_REST ..> Organization : resources from
Backend_orgmgmt_Application ..> RegisterOrganizationCommand : handles
Backend_orgmgmt_Application ..> UpdateOrganizationCommand : handles
Backend_orgmgmt_Application ..> RegisterFacilityCommand : handles
Backend_orgmgmt_Application ..> RegisterBusinessUnitCommand : handles
Backend_orgmgmt_Infrastructure ..> OrganizationRepository : implements

@enduml
