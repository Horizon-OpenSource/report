@startuml
title EcoTrack Platform - Goals and Reduction Plans Backend Bounded Context Layers
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle

package "Goals and Reduction Plans Backend Bounded Context" {
  class "Interfaces REST" as Backend_goals_Interfaces_REST <<layer>>
  class "Application" as Backend_goals_Application <<layer>>
  class "Domain" as Backend_goals_Domain <<layer>>
  class "Infrastructure" as Backend_goals_Infrastructure <<layer>>
}

Backend_goals_Interfaces_REST ..> Backend_goals_Application : commands / queries
Backend_goals_Application ..> Backend_goals_Domain : model and policies
Backend_goals_Application ..> Backend_goals_Infrastructure : repository ports / adapters
Backend_goals_Infrastructure ..> Backend_goals_Domain : persistence mapping
Backend_goals_Interfaces_REST ..> Backend_goals_Domain : resources from aggregates

@enduml
