@startuml
title EcoTrack Platform - Analytics and Reports Frontend Bounded Context Layers
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle

package "Analytics and Reports Frontend Bounded Context" {
  class "Presentation" as Frontend_analytics_Presentation <<layer>>
  class "Application" as Frontend_analytics_Application <<layer>>
  class "Domain" as Frontend_analytics_Domain <<layer>>
  class "Infrastructure" as Frontend_analytics_Infrastructure <<layer>>
}

Frontend_analytics_Presentation ..> Frontend_analytics_Application : dispatches actions
Frontend_analytics_Application ..> Frontend_analytics_Domain : reads / updates view models
Frontend_analytics_Application ..> Frontend_analytics_Infrastructure : requests data
Frontend_analytics_Infrastructure ..> Frontend_analytics_Domain : maps responses to

@enduml
