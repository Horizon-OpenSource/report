@startuml
title EcoTrack Platform - Data Integration Frontend Application Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
hide circle

package "Application" {
  class ImportStore {
    +batches: ImportBatchViewModel[]
    +loading: boolean
    +importCsv(file: File): void
  }

  class ApiKeyFacade {
    +apiKeys: ApiKeyViewModel[]
    +generateKey(): void
    +revokeKey(keyId: number): void
  }
}

package "Presentation" as Frontend_dataint_Presentation <<layer>> {
}
package "Domain" as Frontend_dataint_Domain <<layer>> {
}
package "Infrastructure" as Frontend_dataint_Infrastructure <<layer>> {
}

Frontend_dataint_Presentation ..> ImportStore : dispatches
Frontend_dataint_Presentation ..> ApiKeyFacade : dispatches
ImportStore ..> Frontend_dataint_Domain : updates
ApiKeyFacade ..> Frontend_dataint_Domain : updates
ImportStore ..> Frontend_dataint_Infrastructure : requests
ApiKeyFacade ..> Frontend_dataint_Infrastructure : requests

@enduml
