@startuml
title EcoTrack Platform - IAM Frontend Infrastructure Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
hide circle

package "Infrastructure" {
  class AuthApiService {
    +signIn(request: SignInRequest): Observable<TokenResponse>
    +createAccount(request: CreateUserAccountRequest): Observable<UserResponse>
    +assignRole(userId: number, request: AssignRoleRequest): Observable<UserResponse>
    +requestPasswordReset(request: RequestPasswordResetRequest): Observable<void>
    +resetPassword(request: ResetPasswordRequest): Observable<void>
    +getUsersByOrganization(organizationId: number): Observable<UserResponse[]>
  }

  class InvitationApiService {
    +inviteUser(request: InviteUserRequest): Observable<InvitationResponse>
    +acceptInvitation(request: AcceptInvitationRequest): Observable<UserResponse>
  }

  interface SignInRequest {
    +email: String
    +password: String
  }
  interface CreateUserAccountRequest {
    +fullName: String
    +email: String
    +password: String
  }
  interface AssignRoleRequest {
    +role: String
  }
  interface RequestPasswordResetRequest {
    +email: String
  }
  interface ResetPasswordRequest {
    +token: String
    +newPassword: String
  }
  interface InviteUserRequest {
    +email: String
    +role: String
  }
  interface AcceptInvitationRequest {
    +token: String
    +fullName: String
    +password: String
  }
  interface UserResponse {
    +id: number
    +organizationId: number
    +fullName: String
    +email: String
    +role: String
    +status: String
  }
  interface InvitationResponse {
    +id: number
    +email: String
    +role: String
    +status: String
  }
  interface TokenResponse {
    +accessToken: String
    +expiresAt: String
  }

  class UserAssembler {
    +{static} toViewModel(response: UserResponse): UserViewModel
  }

  class InvitationAssembler {
    +{static} toViewModel(response: InvitationResponse): InvitationViewModel
  }

  AuthApiService ..> SignInRequest : sends
  AuthApiService ..> CreateUserAccountRequest : sends
  AuthApiService ..> AssignRoleRequest : sends
  AuthApiService ..> RequestPasswordResetRequest : sends
  AuthApiService ..> ResetPasswordRequest : sends
  AuthApiService ..> UserResponse : receives
  AuthApiService ..> TokenResponse : receives
  InvitationApiService ..> InviteUserRequest : sends
  InvitationApiService ..> AcceptInvitationRequest : sends
  InvitationApiService ..> InvitationResponse : receives
  UserAssembler ..> UserResponse : converts
  InvitationAssembler ..> InvitationResponse : converts
}

package "Presentation" as Frontend_iam_Presentation <<layer>> {
}
package "Application" as Frontend_iam_Application <<layer>> {
}
package "Domain" as Frontend_iam_Domain <<layer>> {
}
package "EcoTrack Backend API" as Backend <<external>> {
}

Frontend_iam_Application ..> AuthApiService : requests
Frontend_iam_Application ..> InvitationApiService : requests
AuthApiService ..> Backend : HTTPS / JSON
InvitationApiService ..> Backend : HTTPS / JSON
UserAssembler ..> Frontend_iam_Domain : produces
InvitationAssembler ..> Frontend_iam_Domain : produces

@enduml
