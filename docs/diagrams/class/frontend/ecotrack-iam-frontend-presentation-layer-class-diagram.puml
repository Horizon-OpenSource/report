@startuml
title EcoTrack Platform - IAM Frontend Presentation Layer
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam class {
  BackgroundColor #EAF3FC
  BorderColor #0B6FB3
  ArrowColor #4A4A4A
  FontColor #17324D
}
hide circle

package "Presentation" {
  class LoginComponent {
    +email: String
    +password: String
    +onSubmit(): void
  }

  class CreateAccountComponent {
    +fullName: String
    +email: String
    +password: String
    +onSubmit(): void
  }

  class UserManagementComponent {
    +users: UserViewModel[]
    +onInviteUser(): void
    +onAssignRole(userId: number): void
  }

  class InviteUserComponent {
    +email: String
    +role: RoleType
    +onSubmit(): void
  }

  class AcceptInvitationComponent {
    +token: String
    +fullName: String
    +password: String
    +onSubmit(): void
  }

  class RoleAssignmentComponent {
    +userId: number
    +selectedRole: RoleType
    +onConfirm(): void
  }

  class RequestPasswordResetComponent {
    +email: String
    +onSubmit(): void
  }

  class ResetPasswordComponent {
    +token: String
    +newPassword: String
    +onSubmit(): void
  }

  class IamRoutes {
    +routes: Routes
  }

  IamRoutes ..> LoginComponent : routes to
  IamRoutes ..> CreateAccountComponent : routes to
  IamRoutes ..> UserManagementComponent : routes to
  IamRoutes ..> InviteUserComponent : routes to
  IamRoutes ..> AcceptInvitationComponent : routes to
  IamRoutes ..> RoleAssignmentComponent : routes to
  IamRoutes ..> RequestPasswordResetComponent : routes to
  IamRoutes ..> ResetPasswordComponent : routes to
}

package "Application" as Frontend_iam_Application <<layer>> {
}
package "Domain" as Frontend_iam_Domain <<layer>> {
}
package "Infrastructure" as Frontend_iam_Infrastructure <<layer>> {
}

LoginComponent ..> Frontend_iam_Application : dispatches
CreateAccountComponent ..> Frontend_iam_Application : dispatches
UserManagementComponent ..> Frontend_iam_Application : dispatches
InviteUserComponent ..> Frontend_iam_Application : dispatches
AcceptInvitationComponent ..> Frontend_iam_Application : dispatches
RoleAssignmentComponent ..> Frontend_iam_Application : dispatches
RequestPasswordResetComponent ..> Frontend_iam_Application : dispatches
ResetPasswordComponent ..> Frontend_iam_Application : dispatches
UserManagementComponent ..> Frontend_iam_Domain : reads

@enduml
