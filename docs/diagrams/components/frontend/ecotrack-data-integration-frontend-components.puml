@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title EcoTrack - Data Integration Frontend Components Diagram

Container_Boundary(dataIntegration, "Data Integration Frontend Bounded Context") {
  Component(presentation, "Presentation Layer", "Pages / Components / Routes", "Renders the CSV import wizard, API key management and external data status views.")
  Component(application, "Application Layer", "Facade / Store", "Coordinates CSV upload and validation, API key generation and import status tracking.")
  Component(domain, "Domain Layer", "Models / Rules", "Defines import batches, external data records and API key policies at the view level.")
  Component(infrastructure, "Infrastructure Layer", "API Clients / Resources / Assemblers", "Consumes the CSV import and API key resources, and maps responses to frontend models.")
}

System_Ext(backend, "EcoTrack Backend API", "REST API consumed by this frontend context.")
Component_Ext(shared, "Shared Kernel Frontend", "Shared UI / Session", "Provides layout, session, preferences and UI primitives.")
Component_Ext(iam, "IAM", "Frontend Context", "Provides the user's role used to enable CSV import and API key management.")
Component_Ext(emissions, "Emissions Management", "Frontend Context", "Receives the activity data imported through this context.")

Rel(presentation, application, "Dispatches UI actions")
Rel(application, domain, "Applies feature rules")
Rel(application, infrastructure, "Requests data")
Rel(infrastructure, backend, "Consumes REST endpoints")
Rel(presentation, shared, "Uses layout / UI primitives")
Rel(application, shared, "Uses session / preferences")
Rel(iam, application, "Coordinates with")
Rel(application, emissions, "Coordinates with")

SHOW_LEGEND()
@enduml
